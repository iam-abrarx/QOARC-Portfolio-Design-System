      "blocks": [
        {
          "id": "bk_html_6_0",
          "type": "htmlBlock",
          "slots": {
            "html": "<div>\r\n      <p class=\"qo-eyebrow\">03 — Typography</p>\r\n      <h2 class=\"qo-page__title\" style=\"margin-top: var(--qo-space-xs);\">Three families, three jobs.</h2>"
          }
        }
      ]
    },
    {
      "id": "pg_7",
      "theme": "light",
      "master": "qo-page--light",
      "folio": {
        "show": true,
        "label": "03 — Typography"
      },
      "blocks": [
        {
          "id": "bk_html_7_0",
          "type": "htmlBlock",
          "slots": {
            "html": "<div>\r\n      <p class=\"qo-eyebrow\">03 — Typography</p>\r\n      <h2 class=\"qo-page__title\" style=\"margin-top: var(--qo-space-xs);\">Fluid scale</h2>\r\n      <p class=\"qo-page__lede\" style=\"margin-top: var(--qo-space-sm);\">\r\n        A minor-third ratio, clamped between a floor and ceiling so headings\r\n        shrink on small screens without a second stylesheet.\r\n      </p>"
          }
        }
      ]
    },
    {
      "id": "pg_8",
      "theme": "dark",
      "master": "",
      "folio": {
        "show": true,
        "label": "04 — Space &amp; Grid"
      },
      "blocks": [
        {
          "id": "bk_html_8_0",
          "type": "htmlBlock",
          "slots": {
            "html": "<div>\r\n      <p class=\"qo-eyebrow\">04 — Space &amp; Grid</p>\r\n      <h2 class=\"qo-page__title\" style=\"margin-top: var(--qo-space-xs);\">4px base, t-shirt named.</h2>\r\n      <p class=\"qo-page__lede\" style=\"margin-top: var(--qo-space-sm);\">\r\n        Every margin, padding, and gap pulls from this scale. A spacing need\r\n        that doesn't fit is a signal to reconsider the layout, not to reach for\r\n        an arbitrary value.\r\n      </p>"
          }
        }
      ]
    },
    {
      "id": "pg_9",
      "theme": "dark",
      "master": "",
      "folio": {
        "show": true,
        "label": "05 — Elevation"
      },
      "blocks": [
        {
          "id": "bk_html_9_0",
          "type": "htmlBlock",
          "slots": {
            "html": "<div>\r\n      <p class=\"qo-eyebrow\">05 — Elevation</p>\r\n      <h2 class=\"qo-page__title\" style=\"margin-top: var(--qo-space-xs);\">Four rungs, light from above.</h2>\r\n      <p class=\"qo-page__lede\" style=\"margin-top: var(--qo-space-sm);\">\r\n        Depth comes from three things at once: the surface lightens as it rises,\r\n        a hairline highlight catches its top edge, and a two-layer shadow —\r\n        tight contact plus wide ambient — grounds it.\r\n      </p>"
          }
        }
      ]
    },
    {
      "id": "pg_10",
      "theme": "light",
      "master": "qo-page--light",
      "folio": {
        "show": true,
        "label": "06 — Buttons"
      },
      "blocks": [
        {
          "id": "bk_html_10_0",
          "type": "htmlBlock",
          "slots": {
            "html": "<div>\r\n      <p class=\"qo-eyebrow\">06 — Buttons</p>\r\n      <h2 class=\"qo-page__title\" style=\"margin-top: var(--qo-space-xs);\">Primary, secondary, ghost.</h2>\r\n      <p class=\"qo-page__lede\" style=\"margin-top: var(--qo-space-sm);\">\r\n        Only one primary button appears in a view. Secondary carries every\r\n        other real action; ghost is for tertiary controls in dense interfaces.\r\n      </p>"
          }
        }
      ]
    },
    {
      "id": "pg_11",
      "theme": "dark",
      "master": "",
      "folio": {
        "show": true,
        "label": "07 — Project Card"
      },
      "blocks": [
        {
          "id": "bk_html_11_0",
          "type": "htmlBlock",
          "slots": {
            "html": "<div>\r\n      <p class=\"qo-eyebrow\">07 — Project Card</p>\r\n      <h2 class=\"qo-page__title\" style=\"margin-top: var(--qo-space-xs);\">The unit the grid is built from.</h2>\r\n      <p class=\"qo-page__lede\" style=\"margin-top: var(--qo-space-sm);\">\r\n        On hover the surface climbs a rung, the border picks up the accent, and\r\n        the ambient shadow widens. Screenshots supply all the color.\r\n      </p>"
          }
        }
      ]
    },
    {
      "id": "pg_12",
