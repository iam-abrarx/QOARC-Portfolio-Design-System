          "type": "htmlBlock",
          "slots": {
            "html": "<div>\r\n      <p class=\"qo-eyebrow\">08 — Device Mockups</p>\r\n      <h2 class=\"qo-page__title\" style=\"margin-top: var(--qo-space-xs);\">Dropping artwork in.</h2>\r\n      <p class=\"qo-page__lede\" style=\"margin-top: var(--qo-space-2xs);\">\r\n        An <code class=\"qo-badge\">img</code> in the screen slot covers the\r\n        placeholder automatically — frame, angle and bezel never change.\r\n      </p>"
          }
