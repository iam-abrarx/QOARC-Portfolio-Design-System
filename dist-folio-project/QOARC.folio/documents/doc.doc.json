          "slots": {
            "html": "<div>\r\n      <p class=\"qo-eyebrow\">08 — Device Mockups</p>\r\n      <h2 class=\"qo-page__title\" style=\"margin-top: var(--qo-space-xs);\">Desktop &amp; scene.</h2>\r\n      <p class=\"qo-page__lede\" style=\"margin-top: var(--qo-space-sm);\">\r\n        The composition row sits devices on a shared baseline so a responsive\r\n        set reads as one scene rather than three separate specimens.\r\n      </p>"
          }
