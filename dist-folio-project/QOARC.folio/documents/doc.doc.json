    {
      "id": "pg_4",
      "theme": "light",
      "master": "qo-page--light",
      "folio": {
        "show": true,
        "label": "02 — Color"
      },
      "blocks": [
        {
          "id": "bk_html_4_0",
          "type": "htmlBlock",
          "slots": {
            "html": "<div>\r\n      <p class=\"qo-eyebrow\">02 — Color</p>\r\n      <h2 class=\"qo-page__title\" style=\"margin-top: var(--qo-space-xs);\">Palette</h2>\r\n      <p class=\"qo-page__lede\" style=\"margin-top: var(--qo-space-sm);\">\r\n        Five brand colors carry the entire system. Four of them are structural —\r\n        surfaces, text, and rules. Only Signal Teal is an accent.\r\n      </p>"
          }
        }
      ]
    },
    {
      "id": "pg_5",
      "theme": "dark",
      "master": "",
      "folio": {
