      "blocks": [
        {
          "id": "bk_html_12_0",
          "type": "htmlBlock",
          "slots": {
            "html": "<div>\r\n      <p class=\"qo-eyebrow\">08 — Device Mockups</p>\r\n      <h2 class=\"qo-page__title\" style=\"margin-top: var(--qo-space-xs);\">Phone — four views.</h2>\r\n      <p class=\"qo-page__lede\" style=\"margin-top: var(--qo-space-sm);\">\r\n        Carrying Asia Linkage, a garments accessories catalogue. Each screen\r\n        slot is cut to the true device ratio, so a shot exported at 393 × 852\r\n        lands without distortion.\r\n      </p>"
          }
        }
      ]
