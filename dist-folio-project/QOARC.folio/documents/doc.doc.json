            "html": "<div>\r\n      <p class=\"qo-eyebrow\">02 — Color</p>\r\n      <h2 class=\"qo-page__title\" style=\"margin-top: var(--qo-space-xs);\">One accent per view.</h2>"
          }
        }
      ]
    },
    {
      "id": "pg_6",
