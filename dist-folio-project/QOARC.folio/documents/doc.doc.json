        {
          "id": "bk_html_1_1",
          "type": "htmlBlock",
          "slots": {
            "html": "<div>\r\n    <p class=\"qo-eyebrow\">Design System — Version 0.6</p>\r\n    <div class=\"qo-cover__rule\"></div>\r\n    <h1 class=\"qo-cover__title\">Portfolio Design System</h1>\r\n    <p class=\"qo-page__lede\" style=\"margin-top: var(--qo-space-lg); max-width: 52ch;\">\r\n      The visual language every case study in this portfolio is built from —\r\n      color, type, space, elevation, and the components assembled out of them.\r\n    </p>\r\n  </div>"
          }
        },
        {
          "id": "bk_html_1_2",
          "type": "htmlBlock",
          "slots": {
            "html": "<div class=\"qo-cover__scene\">\r\n    <div class=\"qo-device qo-device--laptop qo-view--left\" style=\"width:96mm;\">\r\n      <div class=\"qo-device__frame\"><div class=\"qo-screen\" data-spec=\"1440 × 900\"></div></div>\r\n      <div class=\"qo-device__base\"></div>\r\n    </div>\r\n    <div class=\"qo-device qo-device--phone qo-view--left\" style=\"width:34mm;\">\r\n      <div class=\"qo-device__frame\"><div class=\"qo-screen\" data-spec=\"393 × 852\"></div></div>\r\n    </div>\r\n  </div>"
          }
        },
        {
